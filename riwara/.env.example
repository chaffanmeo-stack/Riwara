# ===== REQUIRED (production) =====
# Neon PostgreSQL pooled connection string. SERVER-ONLY. From: neon.tech > Project > Connection details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon direct (non-pooled) string used by Prisma migrations. SERVER-ONLY.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Secret that signs session cookies. SERVER-ONLY. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Public site URL (canonical links, WhatsApp product links, emails). PUBLIC.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ===== OPTIONAL INTEGRATIONS =====
# Sanity CMS (sanity.io/manage). PUBLIC ids; token is SERVER-ONLY.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
# Email provider (Resend, resend.com/api-keys). SERVER-ONLY.
RESEND_API_KEY=""
EMAIL_FROM=""
# Payment gateway credentials (provider dashboard, requires approved merchant account). SERVER-ONLY.
PAYMENT_PROVIDER=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ===== DEVELOPMENT =====
# One-time admin bootstrap used by `npm run admin:create` (never commit real values).
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""
